# ===== Авторизация и подключение (секреты / окружение) =====
# Остальные параметры (модель, генерация, промпты, тулы) — в config.yaml

# Ключ авторизации (Authorization key) из личного кабинета Studio
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Проверка SSL-сертификатов (для prod лучше установить сертификат Минцифры и указать true)
GIGACHAT_VERIFY_SSL_CERTS=false
# Путь к CA-бандлу (опционально)
GIGACHAT_CA_BUNDLE_FILE=
# Кастомный base_url (опционально, по умолчанию https://api.giga.chat/v1)
GIGACHAT_BASE_URL=

# Путь к файлу конфигурации (опционально, по умолчанию config.yaml рядом с кодом)
CONFIG_PATH=
